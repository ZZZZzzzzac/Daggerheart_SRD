[Unit]
Description=Back up the Daggerheart SRD feedback database
After=proxy_server.service

[Service]
Type=oneshot
User=ubuntu
UMask=0077
WorkingDirectory=/var/www/SRD
ExecStart=/usr/bin/python3 /var/www/SRD/scripts/backup_feedback.py --database /var/www/SRD/var/feedback.db --backup-dir /var/backups/daggerheart-srd --retention-days 30

[Install]
WantedBy=multi-user.target
