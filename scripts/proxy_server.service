[Unit]
Description=Daggerheart SRD GitHub API Proxy
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/SRD
Environment=PROXY_HOST=127.0.0.1
Environment=PROXY_PORT=5000
Environment=FEEDBACK_DB=/var/www/SRD/var/feedback.db
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /var/www/SRD/scripts/proxy_server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
